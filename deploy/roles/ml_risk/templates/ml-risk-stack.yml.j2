services:
  ml-risk:
    image: "{{ ml_risk_image }}"
    environment:
      LOG_FORMAT: "{{ ml_risk_log_format }}"
      MODEL_PATH: "/app/model/risk_model.joblib"
      META_PATH: "/app/model/meta.json"
    networks:
      - traefik-public
    healthcheck:
      test:
        - CMD
        - python
        - -c
        - "import urllib.request; urllib.request.urlopen('http://127.0.0.1:{{ ml_risk_port }}/health', timeout=2)"
      interval: 10s
      timeout: 3s
      retries: 5
      start_period: 20s
    deploy:
      replicas: 1
      placement:
        constraints:
          - node.hostname == app1
      restart_policy:
        condition: on-failure
        delay: 5s
        max_attempts: 3
      update_config:
        parallelism: 1
        delay: 10s
        order: start-first
        failure_action: rollback

networks:
  traefik-public:
    external: true
