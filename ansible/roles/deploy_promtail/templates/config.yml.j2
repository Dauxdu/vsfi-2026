# {{ ansible_managed }}
server:
  http_listen_port: 9080
  grpc_listen_port: 0

positions:
  filename: /tmp/positions.yaml

clients:
  - url: {{ loki_push_url }}

scrape_configs:
  - job_name: containers
    docker_sd_configs:
      - host: unix:///var/run/docker.sock
        refresh_interval: 5s
    relabel_configs:
      - source_labels: ['__meta_docker_container_name']
        regex: '/(.*)'
        target_label: 'container'
      - source_labels: ['__meta_docker_container_label_com_docker_swarm_service_name']
        target_label: 'service'
      - source_labels: ['__meta_docker_node_hostname']
        target_label: 'hostname'
    pipeline_stages:
      - match:
          selector: '{service=~"night-city-jobs_jobs-backend|ml-risk_ml-risk"}'
          stages:
            - json:
                expressions:
                  trace_id: trace_id
                  level: level
            - labels:
                trace_id:
                level:

  - job_name: system
    static_configs:
      - targets:
          - localhost
        labels:
          job: varlogs
          __path__: /var/log/*.log
          hostname: '{{ inventory_hostname }}'