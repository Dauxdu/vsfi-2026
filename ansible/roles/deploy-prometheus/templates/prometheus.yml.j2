# {{ ansible_managed }}

global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/rules/*.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["alertmanager:9093"]

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']
        labels:
          nodename: '{{ inventory_hostname }}'

  - job_name: 'alertmanager'
    static_configs:
      - targets: ['alertmanager:9093']
        labels:
          nodename: '{{ inventory_hostname }}'

  - job_name: 'loki'
    static_configs:
      - targets: ['loki:3100']
        labels:
          nodename: '{{ inventory_hostname }}'

  - job_name: 'node-exporter'
    static_configs:
  {% for host in groups['all'] %}
    - targets: ['{{ hostvars[host].ansible_host }}:9100']
        labels:
          nodename: '{{ host }}'
  {% endfor %}

  - job_name: 'cadvisor'
    dns_sd_configs:
      - names:
          - 'tasks.cadvisor'
        type: 'A'
        port: 8080
    relabel_configs:
      - source_labels: [__meta_dns_name]
        regex: 'tasks\.cadvisor\.(.*)'
        replacement: '${1}'
        target_label: instance
      - target_label: source
        replacement: 'cadvisor'

  - job_name: 'night-city-frontend'
    static_configs:
      - targets: ['nginx-exporter:9113']
        labels:
          service: 'night-city-net'

  - job_name: 'night-city-backend'
    metrics_path: '/metrics'
    static_configs:
      - targets: ['jobs-backend:8080']
        labels:
          service: 'night-city-job-generator'

  - job_name: 'vault'
    metrics_path: /v1/sys/metrics
    params:
      format: [prometheus]
    static_configs:
      - targets: ['vault:8200']
        labels:
          nodename: '{{ groups["mgmt"][0] }}'
          service: 'vault'

  - job_name: 'blackbox-tls'
    metrics_path: /probe
    params:
      module: [tls_connect]
    static_configs:
      - targets:
{% for target in blackbox_tls_targets %}
          - '{{ target }}'
{% endfor %}
        labels:
          probe_type: 'tls'
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox-exporter:9115

  - job_name: 'blackbox-http'
    metrics_path: /probe
    params:
      module: [https_2xx]
    static_configs:
      - targets:
{% for target in blackbox_http_targets %}
          - '{{ target }}'
{% endfor %}
        labels:
          probe_type: 'http'
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox-exporter:9115
