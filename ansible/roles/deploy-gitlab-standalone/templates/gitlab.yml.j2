# {{ ansible_managed }}

http:
  routers:
    gitlab-standalone-router:
      rule: "Host(`{{ gitlab_domain }}`)"
      entryPoints:
        - websecure
      service: gitlab-standalone-service
      tls: {}

  services:
    gitlab-standalone-service:
      loadBalancer:
        servers:
          - url: "http://{{ hostvars[groups['cicd'][0]]['ansible_host'] }}:{{ gitlab_listen_port }}"
        passHostHeader: true
