services:
  traefik:
    image: traefik:{{ traefik_image_tag }}
    volumes:
      - {{ traefik_data_path }}/certs:/certs:ro
      - {{ traefik_data_path }}/dynamic:/etc/traefik/dynamic:ro
      - {{ traefik_data_path }}/traefik.yml:/etc/traefik/traefik.yml:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks:
      - traefik-public
    ports:
      - "80:80/tcp"
      - "443:443/tcp"
    deploy:
      placement:
        constraints:
          - node.role == manager
      restart_policy:
        condition: on-failure
        delay: 10s
        max_attempts: 5
      update_config:
        parallelism: 1
        delay: 5s
        order: start-first
        failure_action: rollback
    healthcheck:
      test: [ "CMD", "traefik", "healthcheck", "--ping" ]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s

  cert-renewer:
    image: alpine:3.22
    command: ["/bin/sh", "-c", "apk add --no-cache openssl jq && /bin/sh /opt/cert-renew/cert-renew.sh"]
    environment:
      VAULT_ADDR: "http://vault:8200"
      VAULT_TOKEN_FILE: "/vault-secrets/vault_keys.json"
      PKI_PATH: "{{ vault_int_pki }}"
      PKI_ROLE: "{{ vault_role_name }}"
      COMMON_NAME: "{{ fulldomain }}"
      ALT_NAMES: "{{ fulldomain }},*.{{ fulldomain }}"
      CERT_TTL: "{{ vault_cert_ttl }}"
    volumes:
      - {{ traefik_data_path }}/certs:/certs
      - {{ traefik_data_path }}/cert-renew.sh:/opt/cert-renew/cert-renew.sh:ro
      - /opt/vault/vault_keys.json:/vault-secrets/vault_keys.json:ro
    networks:
      - traefik-public
    deploy:
      placement:
        constraints:
          - node.role == manager
      restart_policy:
        condition: any
        delay: 10s
        max_attempts: 5

networks:
  traefik-public:
    external: true